# CrokBotTrading — copy to .env and fill in. NEVER commit .env.

# ---- DECISION LAYER (Jev via Omniroute router) ----
# Jev runs at localhost:20128. Model string MUST be openrouter/typesafe/jev-router
# (bare typesafe/jev-router returns 401).
OMNIROUTE_API_KEY=sk-b5a...d1d4

# ---- EXECUTION ----
EXECUTION_MODE=paper          # paper | live
BROKER=paper                  # paper | etoro

# ---- eToro (wired when credentials are provided) ----
ETORO_USERNAME=
ETORO_PASSWORD=
ETORO_APP_KEY=
ETORO_ACCOUNT_ID=

# ---- RISK (all *_pct are percentages, e.g. 1.2 = 1.2%) ----
INITIAL_BALANCE=100000.0
MAX_ORDER_NOTIONAL=5000.0     # max notional per order
MAX_POSITION_NOTIONAL=25000.0 # max gross exposure per symbol
MAX_OPEN_ORDERS=8
MAX_DAILY_LOSS_PCT=5.0
PRICE_BAND_PCT=0.5            # reject quote if it deviates >0.5% from reference
SELF_TRADE_PREVENTION=true

# ---- MARKET MAKING ----
MM_TICK_SIZE=0.01
MM_QUOTE_SIZE=1.0
MM_POST_ONLY=true
MM_MIN_SPREAD_BPS=2

# ---- JEV GATES ----
JEV_CONFIDENCE_FLOOR=0.6